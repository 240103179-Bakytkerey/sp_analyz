# Көшірмесін .env.local деп сақтаңыз (тек өз компьютеріңізде). Vercel-де бұл мәндер
# Settings → Environment Variables бөлімінде жазылады (README қараңыз).

# Postgres (Vercel → Storage → Neon қосқанда өзі пайда болады). Компьютерде бос болса — ./.data/pg (PGlite).
DATABASE_URL=

# Сессия cookie-іне қол қоятын кілт (кемі 16 таңба): openssl rand -base64 32
# Бос болса, кездейсоқ кілт дерекқордағы settings кестесінде бір рет жасалады.
SESSION_SECRET=

# Бірінші әкімші: дерекқорда бірде-бір әкімші жоқ болғанда ғана жасалады. Кейін өшіріп қойыңыз.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# 1 — кірмеген адам да жарияланған есептерді көре алады («Таныстым» бәрібір аккаунт сұрайды). Әдепкі: 0.
PUBLIC_VIEW=0

# SapaLine (ЛС): тек оқуға арналған сервистік аккаунт. Бос болса — JSON/қолмен енгізу жолы жұмыс істейді.
SAPALINE_EMAIL=
SAPALINE_PASSWORD=
# Міндетті емес: SapaLine қоймасының мекенжайы мен anon кілтін ауыстыру.
SAPALINE_URL=
SAPALINE_ANON_KEY=

# JUZ40 платформасы (СТ): HEAD_TEACHER немесе ADMIN рөлі бар аккаунт. Бос болса — JSON/қолмен енгізу.
JUZ40_LOGIN=
JUZ40_PASSWORD=
# Міндетті емес: API мекенжайы (әдепкі https://api.juz40-edu.kz)
JUZ40_API_URL=
